# Copia questo file in .env e riempi i valori:
#   cp .env.example .env
#
# .env è in .gitignore: non committarlo mai, contiene le tue API key.
# Le variabili impostate nella shell hanno la precedenza su questo file.

# ── Provider LLM ────────────────────────────────────────────────────────
# Quale usare. Se lo lasci vuoto viene scelto in base alla key presente.
# Valori: gemini | anthropic
PROVIDER=

# Google AI Studio → https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic Console → https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Modello. Se lo ometti viene usato il default del provider.
MODEL=

# Catena di fallback, separata da virgola. Vuoto = default del provider.
MODEL_FALLBACK=

# ── Server ──────────────────────────────────────────────────────────────
PORT=8787

# Identificativo del dominio richiesto da /v1/manifest
DOMAIN=dom_demo

# ── Limiti e costi ──────────────────────────────────────────────────────
# Ragionamento: THINKING_LEVEL sui modelli Gemini 3.x, THINKING_BUDGET sui 2.5.
THINKING_LEVEL=minimal
THINKING_BUDGET=

# Tetto ai token generati per risposta
MAX_OUTPUT=600

# Richieste al minuto in uscita verso il provider
RPM=10

# Cache in memoria delle richieste identiche: on | off
CACHE=on

# Tetto di richieste al giorno; oltre, il server risponde 429
DAILY_CAP=600
