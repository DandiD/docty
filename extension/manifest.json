{
  "manifest_version": 3,
  "name": "Docty — ponte per agenti",
  "version": "1.3.0",
  "description": "Rende un sito qualunque utilizzabile da un agente: dichiara i suoi tool in un manifest e li inietta nella pagina, senza toccarne il codice.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "scripting",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:8787/*",
    "http://127.0.0.1:8787/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Attiva Docty su questa pagina",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  }
}
